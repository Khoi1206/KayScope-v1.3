# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/kayscope"

# NextAuth v5 — generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"

# Base URL of the app — must match the external port server.ts listens on
# (PORT env, default 3008), not the internal Next.js port. Also used by the
# Playwright flow runner (Phase 5) as baseURL.
NEXTAUTH_URL="http://localhost:3008"

# AES-256-GCM key for encrypting secret env var / cookie values
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAR_ENCRYPTION_KEY="64-character-hex-string-here"

# Redis URL for rate limiting (default: redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# For production or run in docker
AUTH_URL=http://localhost:3008
AUTH_TRUST_HOST=true

# Bootstrap admin account — created once on first server startup if it
# doesn't already exist. Self-registration is disabled; all other accounts
# are created by an admin from the CMS (/admin/users).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_NAME="Administrator"