# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/kayscope"

# NextAuth v5 — generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"

# Base URL of the app — used by Playwright flow runner (Phase 5) as baseURL
NEXTAUTH_URL="http://localhost:3000"

# AES-256-GCM key for encrypting secret env var / cookie values
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAR_ENCRYPTION_KEY="64-character-hex-string-here"

# Redis URL for rate limiting (default: redis://localhost:6379)
REDIS_URL="redis://localhost:6379"