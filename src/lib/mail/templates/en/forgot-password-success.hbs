<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Your password has been changed</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f7fb;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;">
            <tr>
              <td style="padding:24px 32px 0 32px;">
                <h1 style="margin:0;font-size:20px;color:#111827;">Your password has been changed</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 32px 32px;color:#374151;font-size:14px;line-height:1.6;">
                <p>Dear {{name}},</p>
                <p>This is a confirmation that the password for your KayScope account was just changed. If you made this change, no further action is needed.</p>
                <p>If you did not request this change, please contact an administrator immediately.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
